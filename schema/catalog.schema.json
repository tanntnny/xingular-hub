{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "entries": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}\\/[a-z0-9-]{1,64}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z][a-z-]{0,40}$"
          },
          "channel": {
            "type": "string",
            "enum": [
              "official",
              "community"
            ]
          },
          "tags": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 60
            }
          },
          "requires": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            }
          },
          "sourceUrl": {
            "type": "string",
            "maxLength": 2000,
            "format": "uri"
          },
          "delivery": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "registry"
                  },
                  "registryKind": {
                    "type": "string",
                    "enum": [
                      "skills",
                      "prompts",
                      "rules"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "bundled": {
                    "type": "string",
                    "maxLength": 16777216
                  }
                },
                "required": [
                  "kind",
                  "registryKind",
                  "url",
                  "sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "document"
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 2000,
                    "format": "uri"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "bundled": {
                    "type": "string",
                    "maxLength": 16777216
                  }
                },
                "required": [
                  "kind",
                  "url",
                  "sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "pi-package"
                  },
                  "source": {
                    "type": "string",
                    "maxLength": 2000
                  }
                },
                "required": [
                  "kind",
                  "source"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "publisher",
          "license",
          "version",
          "category",
          "channel",
          "tags",
          "requires",
          "sourceUrl",
          "delivery"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "entries"
  ],
  "additionalProperties": false
}
