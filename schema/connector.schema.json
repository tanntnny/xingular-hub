{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "local",
        "remote"
      ]
    },
    "docsUrl": {
      "type": "string",
      "format": "uri"
    },
    "url": {
      "anyOf": [
        {
          "type": "string",
          "format": "starts_with",
          "pattern": "^https:\\/\\/.*"
        },
        {
          "type": "null"
        }
      ]
    },
    "auth": {
      "type": "string",
      "enum": [
        "none",
        "oauth",
        "headers"
      ]
    },
    "oauth": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "client": {
              "type": "string",
              "enum": [
                "dynamic",
                "user"
              ]
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "client",
            "scopes"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "header": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "help": {
            "type": "string"
          }
        },
        "required": [
          "header",
          "label",
          "prefix",
          "help"
        ],
        "additionalProperties": false
      }
    },
    "setup": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notice": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "repositoryOwner": {
              "type": "string",
              "minLength": 1
            },
            "repositoryUrl": {
              "type": "string",
              "format": "starts_with",
              "pattern": "^https:\\/\\/.*"
            },
            "packageName": {
              "type": "string",
              "minLength": 1
            },
            "packageVersion": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "sourceCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            },
            "checkedAt": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          },
          "required": [
            "repositoryOwner",
            "repositoryUrl",
            "packageName",
            "packageVersion",
            "license",
            "sourceCommit",
            "checkedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "suggestedReadTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "kind",
    "docsUrl",
    "url",
    "auth",
    "oauth",
    "fields",
    "setup",
    "notice",
    "provenance",
    "suggestedReadTools"
  ],
  "additionalProperties": false
}
